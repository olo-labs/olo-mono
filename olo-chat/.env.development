# Backend URL (REST + WebSocket). Default for local dev: npm run dev + olo on this machine.
VITE_API_BASE=http://localhost:7080

# When the UI runs inside Docker Compose and the backend service is named `olo`, build with:
#   VITE_API_BASE=http://olo:7080
# (see docker-compose.dev.yml build args — do not rely on this file in the container image.)

# Optional: WebSocket access token (leave unset for dev; use login/sessionStorage if needed).
# VITE_WS_ACCESS_TOKEN=

# Optional: WebSocket ping interval in seconds (default 10).
# VITE_WS_PING_INTERVAL_SEC=10
