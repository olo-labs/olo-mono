# Optional overrides for docker-compose-olo.yml (copy to .env in this folder).
# Paths are resolved relative to the dev/ directory when docker compose runs here.

# Workflow/scenario configuration mounted into olo, olo-ui, and olo-worker.
OLO_CONFIGURATION_SOURCE=./configuration/olo-configuration
# Example monorepo override:
# OLO_CONFIGURATION_SOURCE=../../olo-labs/olo-mono/olo-definition/olo-configuration

# UI extension catalog mounted into olo-ui.
OLO_CATALOG_SOURCE=./configuration/olo-catalog
# Example generated catalog override:
# OLO_CATALOG_SOURCE=../../olo-labs/olo-mono/olo-core/dist/catalog

# Raw document uploads shared by olo and olo-worker.
OLO_RESOURCE_UPLOAD_SOURCE=./configuration/olo-resource-uploads

# olo-ui nginx config.
OLO_UI_NGINX_CONFIG_SOURCE=./configuration/olo-ui/nginx-default.conf

# olo-worker config and logs.
OLO_WORKER_CONFIG_SOURCE=./configuration/olo-worker/config
OLO_WORKER_LOG_SOURCE=./configuration/olo-worker/logs

# Shared tool/demo data mounted into olo-worker.
OLO_SHARED_SOURCE=../../olo-labs/olo-mono/olo-core/tools

# Backend callback URL. Use http://localhost:47080 for host-run workers.
OLO_CHAT_CALLBACK_BASE_URL=http://olo:7080